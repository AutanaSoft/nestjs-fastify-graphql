# Application Configuration
NODE_ENV=development
APP_PORT=4200
APP_USE_GLOBAL_PREFIX=false
APP_GLOBAL_PREFIX=v1
APP_CORRELATION_ID_HEADER=x-correlation-id
APP_LOG_LEVEL=debug
# Admin User Configuration
# Initial admin user credentials for database seeding
# IMPORTANT: Change these values in production!
# If not set, default development credentials will be used
APP_ADMIN_EMAIL=admin@autanasoft.com
APP_ADMIN_PASSWORD=Admin@12345

# Database Configuration (PostgreSQL)
DB_URL="postgresql://postgres:postgres@localhost:5432/app_api_db?schema=public"
DB_NAME=app_api_db

# GraphQL Configuration
GRAPHQL_PLAYGROUND=true
GRAPHQL_INTROSPECTION=true

# JWT Authentication Configuration
# IMPORTANT: Use a strong, random secret in production!
# Generate with: openssl rand -base64 64
JWT_SECRET=RZlmvkPJ7Y25HdSuLTOck+ll+VNn4jwaiBYb9Xj0cgZNFNEXG4b3vizety3FaG660xcVkwbcDJje9KeMY7f/RA==
# Access token expiration (e.g., '15m', '1h', '2h')
JWT_EXPIRES_IN=1h
# Refresh token expiration (e.g., '7d', '30d')
JWT_REFRESH_EXPIRES_IN=7d
# JWT issuer claim - identifies the token issuer
JWT_ISSUER=nestjs-auth-api
# JWT audience claim - identifies intended token recipients
JWT_AUDIENCE=nestjs-auth-client
# Forgot password token expiration (e.g., '10m', '30m')
JWT_TEMP_TOKEN_FORGOT_PASSWORD=10m
# Reset password token expiration (e.g., '10m', '30m')
JWT_TEMP_TOKEN_RESET_PASSWORD=10m
# Verify email token expiration (e.g., '10m', '30m')
JWT_TEMP_TOKEN_VERIFY_EMAIL=10m

# Cryptography Configuration
# IMPORTANT: Use strong, random values in production and keep them secret!
# These are used for encrypting sensitive data (emails, phone numbers, bank accounts, etc.)
# Generate encryption secret (32+ characters): openssl rand -hex 32
ENCRYPTION_SECRET=1e6918cd90ad6886128ee77e5b67a1cfb333877da51107da9c3b6c30339db269
# Generate encryption salt (16+ characters): openssl rand -hex 16
ENCRYPTION_SALT=895b60b0ad5e8f45ea35a96c3ace7819

## SECURITY CONFIGURATION ##
# Helmet CSP Configuration
# Set to 'false' for development (allows GraphQL Playground without restrictions)
# Set to 'true' for production (strict CSP for API-only mode)
HELMET_ENABLE_CSP=false

# Comma-separated list of trusted hosts for API connections
# Only used when HELMET_ENABLE_CSP=true in production
# Used for connectSrc directive to allow WebSocket and HTTP connections
# Example: https://myapp.com,https://api.myapp.com,https://admin.myapp.com
HELMET_TRUSTED_HOSTS=

## CORS CONFIGURATION ##
# CORS Configuration
# Comma-separated list of allowed origins for CORS
# Example: https://example.com,https://app.example.com,https://admin.example.com
# Note: In development, all origins are allowed by default
CORS_ALLOWED_ORIGINS=
# Comma-separated list of allowed HTTP methods for CORS
# Default: GET,HEAD,PUT,PATCH,POST,DELETE,OPTIONS
CORS_ALLOWED_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE,OPTIONS


## THROTTLING CONFIGURATION ##
# Throttling Configuration
# Time to live (TTL) for the rate limit window in seconds
# Default is 60 seconds
THROTTLER_TTL=60
# Maximum number of requests allowed within the TTL window
# Default is 150 requests
THROTTLER_LIMIT=150
